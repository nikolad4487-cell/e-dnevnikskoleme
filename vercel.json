{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/final-thesis/:id", "destination": "/api/final-thesis-handler?id=:id" },
    { "source": "/api/final-thesis", "destination": "/api/final-thesis-handler" },
    { "source": "/api/imenik-warnings", "destination": "/api/imenik-warnings" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
